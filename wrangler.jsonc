{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "worklog",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"observability": {
		"enabled": true
	},
	// React app is served as static assets; /api/* goes to the Worker first.
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "worklog-db",
			// Replace with the id printed by `npx wrangler d1 create worklog-db` (the zeros work for local dev).
			"database_id": "e32efd30-d218-4e6f-9ac7-2fa769645562",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"GEMINI_MODEL": "gemini-flash-latest"
	}
	// Secrets (set with `wrangler secret put NAME`, never committed):
	//   APP_PASSWORD   – the password you log in with
	//   GEMINI_API_KEY – from https://aistudio.google.com/apikey
}
